<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Base.Theme.AppCompat.Light">
        <!-- Customize your theme here. -->
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/icons</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:editTextColor">@color/secondary_text</item>
        <item name="colorButtonNormal">@color/primary</item>
        <item name="dividerVertical">@color/divider</item>
        <!-- 统一页面底色，卡片才有层次 -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="AppPreferenceTheme" parent="AppTheme">
        <item name="android:textColor">@color/primary_text</item>
<!--        <item name="android:editTextColor">@color/primary_text</item>-->
    </style>
    <style name="AppPreferenceSettingsFragmentTheme" parent="@style/AppPreferenceTheme">

        <item name="android:textColorPrimary">@color/primary_text</item>

    </style>

    <!-- 主界面卡片容器：统一的宽高与左右边距。
         视觉属性（背景/圆角/阴影）留在各布局里显式写，便于逐张微调。 -->
    <style name="CardSurface">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_md</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
    </style>

    <!-- 卡片内的标题文字 -->
    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 卡片内的说明文字 -->
    <style name="CardCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- 主操作按钮：统一高度与字号 -->
    <style name="PrimaryActionButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/action_button_height</item>
        <item name="android:textSize">@dimen/action_button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/icons</item>
    </style>

    <!-- 次要按钮：描边样式 -->
    <style name="SecondaryActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/action_button_height</item>
        <item name="android:textSize">@dimen/action_button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:background">@drawable/bg_secondary_button</item>
    </style>

</resources>
