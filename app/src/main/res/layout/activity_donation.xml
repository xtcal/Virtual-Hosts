<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_background"
            tools:context="com.github.xfalcon.vhosts.DonationActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

        <!-- 说明卡 -->
        <androidx.cardview.widget.CardView
                style="@style/CardSurface"
                android:layout_marginTop="@dimen/space_md"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <TextView
                    android:id="@+id/notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_content_padding"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/welcome"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/text_body"/>
        </androidx.cardview.widget.CardView>

        <!-- 评价卡 -->
        <androidx.cardview.widget.CardView
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_rate"
                        style="@style/PrimaryActionButton"
                        android:text="@string/rate"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!--
            支付宝 / 微信 / Paypal / 比特币：四个渠道结构完全一致，
            这里保留各自 id 以便 DonationActivity 继续按渠道隐藏，
            但统一尺寸、间距与文字样式，不再各写一堆 marginTop。
        -->
        <androidx.cardview.widget.CardView
                android:id="@+id/cv_alipay"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_alipay"
                        style="@style/SecondaryActionButton"
                        android:text="@string/alipay"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_wexin"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_weixin"
                        style="@style/SecondaryActionButton"
                        android:text="@string/wechat"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_paypal"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_paypal"
                        style="@style/SecondaryActionButton"
                        android:text="@string/paypal"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_bit"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_bit"
                        style="@style/SecondaryActionButton"
                        android:text="@string/bitcoin"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Google Play 内购：六个金额档位同样结构一致 -->
        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google2"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google2"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay2"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google4"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google4"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay4"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google6"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google6"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google8"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google8"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay8"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/cv_google10"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/bt_google10"
                        style="@style/SecondaryActionButton"
                        android:enabled="false"
                        android:text="@string/googleplay10"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
