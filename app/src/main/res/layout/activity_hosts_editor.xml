<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/window_background"
              tools:context="com.github.xfalcon.vhosts.HostsEditorActivity">

    <!-- 说明区：格式提示，避免用户不知道怎么写 -->
    <TextView
            android:id="@+id/editor_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/editor_hint"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/text_caption"
            android:lineSpacingExtra="2dp"/>

    <!-- 编辑区 -->
    <EditText
            android:id="@+id/editor_input"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:background="@color/surface"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:padding="@dimen/space_md"
            android:scrollbars="vertical"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_body"
            android:importantForAutofill="no"
            tools:ignore="LabelFor"/>

    <!-- 底部：实时解析条数 + 操作按钮 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_md">

        <TextView
                android:id="@+id/editor_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/editor_parsed_zero"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/text_caption"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                    android:id="@+id/editor_button_sample"
                    style="@style/SecondaryActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="@string/editor_insert_sample"/>

            <Button
                    android:id="@+id/editor_button_save"
                    style="@style/PrimaryActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/editor_save"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
