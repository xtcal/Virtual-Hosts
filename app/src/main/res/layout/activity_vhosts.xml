<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/window_background"
            tools:context="com.github.xfalcon.vhosts.VhostsActivity">

    <LinearLayout
            android:id="@+id/activity_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

        <!-- ① 运行状态：把原来只能靠开关猜的状态明确写出来 -->
        <androidx.cardview.widget.CardView
                android:id="@+id/card_status"
                style="@style/CardSurface"
                android:layout_marginTop="@dimen/space_md"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:id="@+id/status_dot"
                            android:layout_width="@dimen/status_dot_size"
                            android:layout_height="@dimen/status_dot_size"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:background="@drawable/dot_stopped"/>

                    <TextView
                            android:id="@+id/status_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/status_stopped"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold"/>

                    <!-- 规则条数徽标 -->
                    <TextView
                            android:id="@+id/rule_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_stopped"
                            android:paddingStart="@dimen/space_sm"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingBottom="@dimen/space_xs"
                            android:text="@string/status_no_rules"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_caption"/>
                </LinearLayout>

                <TextView
                        android:id="@+id/status_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/status_stopped_desc"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/text_body"/>

                <!-- 主开关：用标准 Switch 替代原来 -90° 旋转的 SwitchButton -->
                <com.github.xfalcon.vhosts.widget.LabeledSwitch
                        android:id="@+id/switch_vpn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ② 规则来源 -->
        <androidx.cardview.widget.CardView
                android:id="@+id/card_source"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <TextView
                        style="@style/CardTitle"
                        android:text="@string/source_title"/>

                <TextView
                        android:id="@+id/source_value_text"
                        style="@style/CardCaption"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/source_builtin_desc"/>

                <Button
                        android:id="@+id/button_edit_rules"
                        style="@style/PrimaryActionButton"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/action_edit_rules"/>

                <Button
                        android:id="@+id/button_select_hosts"
                        style="@style/SecondaryActionButton"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_choose_file"/>

                <Button
                        android:id="@+id/button_settings"
                        style="@style/SecondaryActionButton"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_settings"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ③ 其他：开机自启 / 捐赠。原先是 3 个彩色 FAB，收进卡片后层级更清晰 -->
        <androidx.cardview.widget.CardView
                android:id="@+id/card_actions"
                style="@style/CardSurface"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">

                <Button
                        android:id="@+id/button_boot"
                        style="@style/SecondaryActionButton"
                        android:text="@string/action_boot_off"/>

                <Button
                        android:id="@+id/button_donation"
                        style="@style/SecondaryActionButton"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_donate"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
