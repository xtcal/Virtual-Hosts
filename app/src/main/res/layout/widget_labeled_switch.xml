<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/toggle_text_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_stopped"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/switch_text_size"/>

        <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

        <Switch
                android:id="@+id/toggle_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"/>

        <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

        <TextView
                android:id="@+id/toggle_text_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_running"
                android:textColor="@color/state_running"
                android:textSize="@dimen/switch_text_size"
                android:textStyle="bold"
                android:visibility="gone"/>
    </LinearLayout>
</merge>
